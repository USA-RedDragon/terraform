#!/bin/bash
# Planet basemap build. Runs once, publishes, terminates.
# Rendered from build.sh.tftpl by terraform; do not edit on the box.
# -E (errtrace) IS LOAD-BEARING, NOT DECORATION. Without it an ERR trap is NOT
# inherited by shell functions, so a failure inside r2() -- which is every
# upload -- kills the script while fail() never runs: no mail, no terminate,
# the box left for the dead-man switch reporting nothing. Verified: `set -euo`
# exits 1 with the handler silent; `set -Eeuo` runs the handler.
set -Eeuo pipefail

# Early bailout: fail() cannot exist until the SMTP key is read, and plenty can
# break before that. Sleeps so CloudWatch flushes before the box dies.
trap 'rc=$?; if [ "$rc" -ne 0 ]; then echo "FATAL: exited $rc before the reporting trap was armed"; sleep 45; shutdown -h now; fi' EXIT

# LOGGING FIRST, before anything that can fail. A failure earlier than this
# creates NO log stream at all and terminated instances lose console output
# within minutes -- which made one failure unrecoverable. See README.
mkdir -p /var/log
touch /var/log/basemap-build.log
dnf install -y amazon-cloudwatch-agent >/dev/null 2>&1 || echo "WARNING: cloudwatch agent unavailable; logs stay on the box"
if [ -d /opt/aws/amazon-cloudwatch-agent ]; then
  mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
  cat > /opt/aws/amazon-cloudwatch-agent/etc/basemap.json <<CWCFG
{"logs":{"logs_collected":{"files":{"collect_list":[
  {"file_path":"/var/log/basemap-build.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}"},
  {"file_path":"/var/log/cloud-init-output.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}-cloudinit"}
]}}}}
CWCFG
  /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/basemap.json >/dev/null 2>&1 \
    || echo "WARNING: cloudwatch agent did not start; logs stay on the box"
fi

# Everything from here is captured, both locally and in CloudWatch.
exec > >(tee -a /var/log/basemap-build.log) 2>&1
echo "=== log shipping armed; beginning build ==="

REGION="${region}"
LOG_GROUP="${log_group}"
R2_PARAM="${r2_param}"
SMTP_PARAM="${smtp_param}"
R2_BUCKET="${r2_bucket}"
R2_ENDPOINT="https://${r2_account_id}.r2.cloudflarestorage.com"
ARCHIVE_BASE="${archive_base_url}"
ALERT_TO="${alert_email}"
ALERT_FROM="${alert_from}"
SMTP_HOST="${smtp_host}"
SMTP_PORT="${smtp_port}"
PLANETILER_VERSION="${planetiler_version}"

# DEAD-MAN SWITCH, ARMED FIRST, BEFORE ANYTHING CAN FAIL.
# Paired with instance_initiated_shutdown_behavior=terminate in the launch
# template. If this script hangs, deadlocks, or dies before its cleanup, the
# box still dies. Nothing has to notice.
shutdown -h +${max_build_minutes} &

# IMDS with a retry: `set -e` makes a first-attempt miss fatal otherwise.
IID=""
for i in $(seq 1 20); do
  TOK=$(curl -sf -X PUT http://169.254.169.254/latest/api/token \
        -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' 2>/dev/null) || TOK=""
  if [ -n "$TOK" ]; then
    IID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOK" \
          http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null) || IID=""
    [ -n "$IID" ] && { echo "IMDS answered after $((i*2))s: $IID"; break; }
  fi
  sleep 2
done
if [ -z "$IID" ]; then
  echo "FATAL: IMDS never returned an instance id after 40s"
  exit 1
fi
GEN="omt-$(date -u +%Y%m%d)"
KEY="basemap/$GEN.pmtiles"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo "=== $GEN on $IID, started $STARTED ==="


# Retry GetParameter ITSELF, not `sts get-caller-identity` -- STS accepts
# instance-profile credentials ~3s before SSM does. See README.
ssm_get() {
  local n="$1" v="" i
  for i in $(seq 1 40); do
    if v=$(aws ssm get-parameter --region "$REGION" --name "$n" \
             --with-decryption --query Parameter.Value --output text 2>/dev/null); then
      if [ -n "$v" ] && [ "$v" != "None" ]; then
        echo "read $n after $((i*3))s" >&2
        printf '%s' "$v"
        return 0
      fi
    fi
    sleep 3
  done
  echo "FATAL: could not read $n after 120s" >&2
  return 1
}

# Credentials: read BOTH first, then NEVER export the R2 keys -- the SDK
# prefers env credentials, so exporting Cloudflare keys breaks every later AWS
# call. Cost a build 2026-08-28. See README, "What a healthy boot looks like".
CREDS=$(ssm_get "$R2_PARAM")
SMTP_KEY=$(ssm_get "$SMTP_PARAM")
R2_KEY_ID=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["access_key_id"])' <<<"$CREDS")
R2_SECRET=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["secret_access_key"])' <<<"$CREDS")
unset CREDS

# One wrapper, so no call site can forget the scoping.
r2() {
  AWS_ACCESS_KEY_ID="$R2_KEY_ID" AWS_SECRET_ACCESS_KEY="$R2_SECRET" \
  AWS_DEFAULT_REGION=auto aws s3 "$@" --endpoint-url "$R2_ENDPOINT" --only-show-errors
}

# ASSERT, do not assume. `set -e` catches a non-zero exit, but an empty or
# malformed parameter exits 0 and yields an empty string -- which then SHADOWS
# the instance profile, because the SDK prefers environment credentials. That
# failure surfaces 90 minutes later at the upload, as far from its cause as it
# is possible to get.
for v in R2_KEY_ID R2_SECRET SMTP_KEY; do
  if [ -z "$${!v}" ]; then
    echo "FATAL: $v is empty after reading SSM. Check the parameter and the instance role."
    shutdown -h now
    exit 1
  fi
done
echo "credentials loaded: R2 key id ends ...$${R2_KEY_ID: -4}, smtp key $${#SMTP_KEY} chars"

notify() { # subject, body
  python3 - "$1" "$2" <<'PY' || echo "WARNING: mail failed, continuing"
import os, smtplib, ssl, sys
from email.message import EmailMessage
m = EmailMessage()
m["Subject"], m["From"], m["To"] = sys.argv[1], os.environ["ALERT_FROM"], os.environ["ALERT_TO"]
m.set_content(sys.argv[2])
# timeout=30 IS LOAD-BEARING. Without it, a relay that accepts the connection
# and then stalls hangs the script forever. On 2026-08-28 the archive published
# and verified correctly, then the box sat for hours in send_message() and never
# reached its own terminate-instances -- ~$3 of spot time after the work was
# already done. `|| echo` cannot rescue a call that never returns.
with smtplib.SMTP_SSL(os.environ["SMTP_HOST"], int(os.environ["SMTP_PORT"]), timeout=30, context=ssl.create_default_context()) as s:
    s.login("squallar", os.environ["SMTP_KEY"]); s.send_message(m)
PY
}
export SMTP_HOST SMTP_PORT SMTP_KEY ALERT_TO ALERT_FROM

# FAILURE IS REPORTED, AND THEN THE BOX STILL DIES.
# The trap is the courtesy; the shutdown above is the guarantee.
fail() {
  echo "FAILED at line $1"
  notify "squallar basemap $GEN FAILED" "$(printf 'Instance %s\nStarted %s\nFailed at line %s\n\n--- last 80 lines ---\n%s\n' "$IID" "$STARTED" "$1" "$(tail -80 /var/log/basemap-build.log)")"
  aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || shutdown -h now
  exit 1
}
trap - EXIT          # the early bailout trap has done its job
trap 'fail $LINENO' ERR
set -eE

# mdadm BEFORE the striping block, not with the Java install below it: `mdadm`
# was called six lines before it was installed, which failed every multi-volume
# launch at line 170 while single-volume types would have passed.
dnf install -y mdadm >/dev/null

# --- scratch on instance-store NVMe, never EBS ---
# STRIPE ALL INSTANCE-STORE VOLUMES, do not take the first.
#
# Taking one disk left half the machine's storage unused on every multi-volume
# type in the fleet -- 1425 of 2850 GB on the m6id.12xlarge this ran on, 1425 of
# 5700 on a c6id.24xlarge. That is fine for the OSM build (287 GB of features)
# and NOT fine for the contour job, whose GeoJSON intermediate is 0.28-1.24 TB
# globally. Striping also roughly doubles throughput on the phases that are
# I/O-bound rather than CPU-bound, which `archive` is.
DISKS=$(lsblk -dnp -o NAME,MODEL | grep -i "instance storage" | awk '{print $1}')
COUNT=$(wc -w <<<"$DISKS")
[ "$COUNT" -ge 1 ] || { echo "no instance store found"; false; }
if [ "$COUNT" -eq 1 ]; then
  DEV="$DISKS"
  echo "one instance-store volume: $DEV"
else
  echo "striping $COUNT instance-store volumes: $DISKS"
  mdadm --create /dev/md0 --level=0 --raid-devices="$COUNT" --run $DISKS
  DEV=/dev/md0
fi
mkfs.xfs -f "$DEV"; mkdir -p /scratch; mount "$DEV" /scratch
df -h /scratch

dnf install -y java-21-amazon-corretto-headless >/dev/null
curl -fSL --retry 5 -o /scratch/planetiler.jar \
  "https://github.com/onthegomap/planetiler/releases/download/v$PLANETILER_VERSION/planetiler.jar"

# --- build ---
cd /scratch
# -Xmx30g AND NOT MORE, on a 128 GiB box. Counter-intuitive and load-bearing:
# with --storage=mmap planetiler wants a SMALL heap and leaves the rest to the
# OS page cache, which is what holds the ~114 GB node and multipolygon cache.
# A large -Xmx starves exactly the cache the mmap path depends on and the build
# gets slower, not faster.
java -Xmx30g -jar planetiler.jar \
  --area=planet --download --download-threads=8 \
  --output=/scratch/$GEN.pmtiles --output-layerstats --force \
  --nodemap-type=array --storage=mmap

BYTES=$(stat -c%s "/scratch/$GEN.pmtiles")
echo "built $GEN: $BYTES bytes"

# --- publish to a VERSIONED IMMUTABLE KEY ---
# Never overwrite a live key. A corrupt archive on a path users already read is
# the worst version of silent partial success.
r2 cp "/scratch/$GEN.pmtiles" "s3://$R2_BUCKET/$KEY" --content-type application/octet-stream
r2 cp "/scratch/$GEN.pmtiles.layerstats.tsv.gz" "s3://$R2_BUCKET/basemap/$GEN.layerstats.tsv.gz" || true

# --- VERIFY THROUGH THE PUBLIC PATH, not through the writer ---
# Reading it back over HTTPS proves the bytes are servable, that ranges work,
# and that CORS/routing are intact -- none of which a successful PUT proves.
sleep 10
HDR=$(curl -sf -r 0-126 "$ARCHIVE_BASE/$KEY" | xxd -p | head -c 14)
[ "$HDR" = "504d54696c6573" ] || { echo "published archive does not begin with PMTiles magic: $HDR"; false; }
REMOTE=$(curl -sfI "$ARCHIVE_BASE/$KEY" | grep -i '^content-length:' | tr -d '\r' | awk '{print $2}')
[ "$REMOTE" = "$BYTES" ] || { echo "size mismatch: local $BYTES remote $REMOTE"; false; }
echo "verified $KEY through the public path"

# --- THE STATUS OBJECT IS WRITTEN LAST. It is what publishes the generation. ---
FINISHED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"generation":"%s","key":"%s","bytes":%s,"started":"%s","completed":"%s"}\n' \
  "$GEN" "$KEY" "$BYTES" "$STARTED" "$FINISHED" > /scratch/latest.json
r2 cp /scratch/latest.json "s3://$R2_BUCKET/status/latest.json" --content-type application/json --cache-control "max-age=60"

notify "squallar basemap $GEN published ($((BYTES/1000000000)) GB)" \
  "$(printf 'generation %s\nkey        %s\nbytes      %s\nstarted    %s\ncompleted  %s\ninstance   %s\n\nlayerstats basemap/%s.layerstats.tsv.gz\n' \
     "$GEN" "$KEY" "$BYTES" "$STARTED" "$FINISHED" "$IID" "$GEN")"

echo "=== done, terminating ==="
aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID"
